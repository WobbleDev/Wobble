{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["src/routes/**/*.{ts,svelte}", "e2e/**/*.ts"],
	"project": ["src/lib/**/*.{ts,svelte}", "!src/lib/components/ui/**", "!src/lib/utils.ts"],
	"ignore": [
		".worktrees/**",
		".scratch/**",
		"target/**",
		"src-tauri/gen/**",
		"src-tauri/icons/**",
		"src/lib/paraglide/**",
		"src/lib/client/generated/**"
	],
	// Ticket 01 stops rendering the old Overview modules without deleting them
	// (ticket 06 removes them). Exports consumed inside their own files are not
	// reported until then.
	"ignoreExportsUsedInFile": true,
	"rules": {
		"exports": "error",
		"types": "off",
		"files": "off",
		"dependencies": "off",
		"unlisted": "off",
		"duplicates": "off",
		"enumMembers": "off",
		"nsExports": "off"
	}
}
