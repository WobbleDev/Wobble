#!/bin/sh
# Pre-push guardrail: never push straight to main; then the whole-repo lint.
while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = "refs/heads/main" ]; then
		echo "pre-push: direct pushes to main are blocked; open a pull request." >&2
		exit 1
	fi
done
npm run lint || exit 1
